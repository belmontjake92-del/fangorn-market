# ─────────────────────────────────────────────────────────────────────────────
# Fangorn Market - environment
# Copy to `.env` and fill in. NEVER commit `.env` (it is git-ignored; this
# .env.example, with blank values, is the committed template).
# Phase 0 needs NONE of these (the Sepolia connectivity check runs read-only).
# ─────────────────────────────────────────────────────────────────────────────

# --- Chain (Arbitrum Sepolia today; swap for Robinhood Chain later) ---
# Dedicated endpoint recommended. Must be arb-SEPOLIA, not arb-mainnet.
ARBITRUM_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# --- Publisher / deployer wallet (funded with Arbitrum Sepolia ETH) ---
# 0x-prefixed private key of a THROWAWAY testnet wallet. Needed from Phase 1.
FANGORN_PRIVATE_KEY=

# --- IPFS storage (Pinata) - needed from Phase 1 to publish to The Grove ---
PINATA_JWT=
PINATA_GATEWAY=

# --- Fangorn protocol contracts (defaults ship with the SDK; override if needed) ---
DATA_REGISTRY_ADDRESS=0x9a3811b365a4aeea1626eaad185b273424ae5e48
