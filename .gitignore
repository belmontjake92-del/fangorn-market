# dependencies
node_modules/
.pnpm-store/

# build output
dist/
lib/
*.tsbuildinfo

# hardhat build artifacts (regenerated)
contracts/artifacts/
contracts/cache/

# env & secrets: NEVER commit
.env
.env.*
!.env.example

# local CLI binaries (not part of the app)
flybin/
ghbin/

# fangorn local pointer state
.fangorn/

# local runtime data (sqlite, etc.)
.data/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# local reference clones of the upstream repos (consumed from npm, not built here)
/_repos/
